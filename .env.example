# Public (shipped to the browser) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (NEVER prefix with NEXT_PUBLIC_) -------------------------------
# Create one in: Supabase Dashboard -> Project Settings -> API Keys ->
# Secret keys -> "Create new secret key". Prefer this over the legacy
# service_role JWT. Either format works; the code reads SUPABASE_SECRET_KEY
# first and falls back to SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated list of admin emails (lowercase match). Only these addresses
# can import topics and advance voting phases.
ADMIN_EMAILS=you@example.com
